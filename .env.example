# Optional. Pre-fills the Canvas connection form in Settings so you do not have to
# paste your institution URL every time. Everything here is read on the server only.
#
# Your Canvas host, e.g. https://canvas.instructure.com or https://myschool.instructure.com
CANVAS_BASE_URL=

# Optional. A Canvas API access token (Canvas > Account > Settings > New Access Token).
# If set, Proxima uses it as a fallback when no token is saved in the browser.
CANVAS_ACCESS_TOKEN=
